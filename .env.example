# Safe default: no external model call is made.
TRISCAN_MODEL_PROVIDER=mock
TRISCAN_MODEL_NAME=Qwen/Qwen3-VL-2B-Instruct

# For provider=openai_compatible (vLLM, SGLang, or another compatible server)
TRISCAN_API_BASE_URL=http://localhost:8000/v1
TRISCAN_API_KEY=EMPTY

# Generation and document limits
TRISCAN_MAX_NEW_TOKENS=4096
TRISCAN_TEMPERATURE=0.0
TRISCAN_REQUEST_TIMEOUT_SECONDS=180
TRISCAN_MAX_FILE_MB=25
TRISCAN_MAX_PDF_PAGES=20
TRISCAN_PDF_DPI=160
TRISCAN_MAX_IMAGE_MEGAPIXELS=16
TRISCAN_MAX_BATCH_FILES=10

# Runtime output. Keep uploaded documents private and delete runs when no longer needed.
TRISCAN_RUNS_DIR=./runs
TRISCAN_LOG_LEVEL=INFO

