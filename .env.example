# Safe default: no external model call is made.
TSCAN_MODEL_PROVIDER=mock
TSCAN_MODEL_NAME=Qwen/Qwen3-VL-2B-Instruct
# Pin an immutable model commit for reproducible baselines.
TSCAN_MODEL_REVISION=main

# For provider=openai_compatible (vLLM, SGLang, or another compatible server)
TSCAN_API_BASE_URL=http://localhost:8000/v1
TSCAN_API_KEY=EMPTY

# Generation and document limits
TSCAN_MAX_NEW_TOKENS=4096
TSCAN_TEMPERATURE=0.0
TSCAN_REQUEST_TIMEOUT_SECONDS=180
TSCAN_MAX_FILE_MB=25
TSCAN_MAX_PDF_PAGES=20
TSCAN_PDF_DPI=160
TSCAN_MAX_IMAGE_MEGAPIXELS=16
TSCAN_MAX_BATCH_FILES=10

# Runtime output. Keep uploaded documents private and delete runs when no longer needed.
TSCAN_RUNS_DIR=./runs
TSCAN_LOG_LEVEL=INFO
